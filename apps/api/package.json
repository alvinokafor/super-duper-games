{
  "name": "@bankroll/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:pull": "drizzle-kit pull && node scripts/after-db-pull.mjs",
    "smoke:social": "node --env-file-if-exists=.env scripts/smoke-social.mjs",
    "smoke:match": "node --env-file-if-exists=.env scripts/smoke-match.mjs"
  },
  "dependencies": {
    "@bankroll/contracts": "workspace:*",
    "@bankroll/lagos-rules": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
